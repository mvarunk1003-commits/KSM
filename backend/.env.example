# =============================================================================
# Kolar Sringeri SriShankara Mutt — Environment Configuration Example
# Cloud Provider: AWS
# Region: ap-south-1 (Asia Pacific - Mumbai)
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# AWS Cloud Settings
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-aws-account-id

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ksm_temple_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX=20

# SSL Configuration (Set to true if connecting to AWS RDS / EC2 with SSL)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional SSL PEM Certificates / CA
# DB_SSL_CA_PATH=./keys/global-bundle.pem
# DB_SSL_KEY_PATH=./keys/client-key.pem
# DB_SSL_CERT_PATH=./keys/client-cert.pem

# =============================================================================
# SSH Tunnel Configuration with AWS Private PEM Key
# (Enable this if your Node server runs outside AWS and connects to EC2 Postgres)
# =============================================================================
SSH_TUNNEL_ENABLED=false
SSH_HOST=your-ec2-ip.ap-south-1.compute.amazonaws.com
SSH_PORT=22
SSH_USER=ec2-user                       # ec2-user (Amazon Linux) or ubuntu (Ubuntu)
SSH_KEY_PATH=./keys/your-ec2-key.pem    # Relative or absolute path to your .pem key
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432

# =============================================================================
# pgAdmin 4 Access Details
# URL: http://<EC2_PUBLIC_IP>:5050
# =============================================================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=YourPgAdminPassword123!
